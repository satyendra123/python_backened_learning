# find the largest and second_largest number in an array
nums = [15, 28, 7, 19, 12]
largest=nums[0]
second_largest=largest

for i in range(0,len(nums)):
    if largest < nums[i]:
        largest=nums[i]

print(largest)


for i in range(0,len(nums)):
    if nums[i] > second_largest and nums[i]!=largest:
        second_largest=nums[i]
        
print(second_largest)
